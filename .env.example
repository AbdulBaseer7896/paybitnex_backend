# ════════════════════════════════════════════════════════════════════
# PayBitnex backend — environment variables
# Copy this file to `.env` (same directory as manage.py) and fill in
# the real values. NEVER commit `.env` to git.
# ════════════════════════════════════════════════════════════════════

# ── Django core ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-production-domain.com

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/django_db

# ── Redis (cache + celery) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# By default, Django uses local memory cache (LocMemCache) to avoid Redis dependency on Windows.
# Set USE_REDIS_CACHE=True to enable Redis for caching.
USE_REDIS_CACHE=False

# ── AWS S3 (file storage) ───────────────────────────────────────────
# Private bucket. Files are served via time-limited signed URLs.
# Bucket MUST have "Block all public access = ON" in the AWS console.
AWS_ACCESS_KEY_ID=AKIA_YOUR_NEW_ROTATED_KEY
AWS_SECRET_ACCESS_KEY=YourNewRotatedSecretKey
AWS_STORAGE_BUCKET_NAME=my-backups-storage-bitnext-1
AWS_S3_REGION_NAME=us-east-1
# Everything is uploaded under this key prefix inside the bucket.
AWS_S3_LOCATION=backup/documents/paybitnexdocuments
# TTL (seconds) for signed URLs. 3600 = 60 min. Applies to
# authenticated portal access. Public invoice pages override this
# per-request with a TTL bounded by invoice.expires_at.
S3_SIGNED_URL_TTL=3600

# ── Cloudinary (legacy — kept for existing files only) ──────────────
# Safe to leave empty if you're not reading any old Cloudinary files.
# The app no longer uploads NEW files to Cloudinary — everything
# goes to S3 — but these values let the Cloudinary SDK import cleanly
# and let old snapshot URLs keep resolving.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Exchange rate API ───────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=your-key-here
EXCHANGE_RATE_PROVIDER=exchangerate-api

# ── CORS / JWT ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://paybitnex.netlify.app
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ── Email (SMTP via aiosmtplib) ─────────────────────────────────────
# myapp/Utils/email_tasks.py uses aiosmtplib to talk SMTP directly
# from a background thread — no Celery worker required. The Django
# SMTP backend setting is kept so other tooling (e.g. management
# commands) that uses django.core.mail still picks up the same creds.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.bitnexpayout.com
EMAIL_PORT=465
# Use SSL for implicit TLS on port 465; flip to EMAIL_USE_TLS=True
# (and EMAIL_USE_SSL=False, port 587) for STARTTLS providers.
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@bitnexpayout.com
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=info@bitnexpayout.com
EMAIL_FROM_NAME=PayBitnex
EMAIL_TIMEOUT=20
